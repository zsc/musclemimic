{
  "name": "musclemimic-web-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-static.mjs && vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-static.mjs",
    "build": "vite build",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:physics": "node scripts/test-physics.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:audit": "node scripts/audit-browser.mjs",
    "test:video-camera": "node scripts/test-video-camera.mjs",
    "demo": "npm run build && npm run preview",
    "test:recording": "node scripts/test-recording.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@mujoco/mujoco": "3.17.0",
    "onnxruntime-web": "1.30.0",
    "three": "0.181.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "vite": "7.1.12"
  }
}
